---
import BaseLayout from '../layouts/BaseLayout.astro';
const reportAreas = ['Reading clubs and literacy initiatives', 'Schools and communities engaged', 'Learners and young people reached', 'Volunteers involved', 'Education and human rights activities', 'Partnerships and programme milestones', 'Stories of progress and lessons learned'];
---
<BaseLayout title="Our impact" description="How Back 2 School Africa Programme plans to report its education work, community partnerships and verified progress.">
  <section class="page-hero"><div class="wrap narrow"><span class="eyebrow">Our impact</span><h1>Creating opportunities through education.</h1><p class="lead">Meaningful educational change begins with action, collaboration and accountability.</p></div></section>
  <section class="section"><div class="wrap two-col"><div><span class="eyebrow">Our work in view</span><h2>A place to share progress and learning.</h2></div><div class="prose"><p>This page will share the work of Back 2 School Africa Programme, the communities we engage with, the partnerships we build and the progress of our initiatives.</p><p>It will grow as programmes are implemented and evidence is collected.</p></div></div></section>
  <section class="section wash"><div class="wrap"><span class="eyebrow">What we report</span><h2 class="section-title">A fuller picture of our work.</h2><div class="impact-grid">{reportAreas.map((area, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><p>{area}.</p></div>)}</div></div></section>
  <section class="section"><div class="wrap two-col"><div><span class="eyebrow">Our commitment to accountability</span><h2>Evidence and permission come first.</h2></div><div class="prose"><p>We aim to communicate our activities and results transparently. Impact figures and success stories will be published only when they have been verified and appropriate permission has been obtained.</p><p>No impact figures or personal stories are published here yet.</p><a class="text-link" href="/get-involved/">Support the work <span aria-hidden="true">→</span></a></div></div></section>
</BaseLayout>
