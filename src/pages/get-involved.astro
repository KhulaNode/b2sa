---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
const hasContact = Boolean(siteConfig.contactEmail.trim() || siteConfig.contactPhone.trim());
---
<BaseLayout title="Get involved" description="Volunteer, partner, sponsor a programme or support education opportunities with Back 2 School Africa Programme.">
  <section class="page-hero"><div class="wrap narrow"><span class="eyebrow">Get involved</span><h1>Help expand educational opportunities.</h1><p class="lead">Progress is possible when individuals and institutions work together. Find a way to contribute time, expertise, resources or a partnership.</p></div></section>
  <section class="section"><div class="wrap involvement-list">
    <article id="volunteers"><div class="involvement-index">01 / Volunteer</div><div><h2>Volunteer with us</h2><p>Contribute your time, skills or professional experience to education, literacy, youth development or community initiatives.</p><div class="inline-links"><a href="/#programmes">Explore programmes ↗</a><a href="/contact/">Contact information ↗</a></div></div></article>
    <article id="partners"><div class="involvement-index">02 / Collaborate</div><div><h2>Partner with us</h2><p>We welcome collaboration with schools, universities, TVET colleges, civil society organisations, public institutions and businesses.</p><div class="inline-links"><a href="/contact/">Contact information ↗</a></div></div></article>
    <article id="sponsors"><div class="involvement-index">03 / Contribute</div><div><h2>Sponsor a programme</h2><p>Support education-focused initiatives through financial contributions, learning resources, equipment, training or other approved forms of assistance.</p><div class="inline-links"><a href="/#programmes">See programme areas ↗</a>{siteConfig.donationUrl && <a href={siteConfig.donationUrl}>Confirmed donation channel ↗</a>}</div></div></article>
    <article id="supporters"><div class="involvement-index">04 / Share</div><div><h2>Become a programme supporter</h2><p>Help share verified opportunities, connect communities with resources and raise awareness about education and youth development.</p><div class="inline-links"><a href="/education-opportunities/">Education opportunities ↗</a></div></div></article>
    <article id="learners"><div class="involvement-index">05 / Learn</div><div><h2>Learners and families</h2><p>Explore programme areas and education guidance.</p><div class="inline-links"><a href="/education-opportunities/">Explore opportunities ↗</a><a href="/#programmes">Programme areas ↗</a></div></div></article>
  </div></section>
  <section class="section wash"><div class="wrap editorial-callout"><span class="eyebrow">Contact us to get involved</span><h2>Tell us how you would like to contribute.</h2><p>{hasContact ? 'Use our confirmed public contact channel to ask about current opportunities and requirements. Please share only the details needed for an initial enquiry.' : 'Our public contact channel is being confirmed. Check the contact page for the latest details before sharing personal information.'}</p><a class="button" href="/contact/">Contact information <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
