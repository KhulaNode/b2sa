---
import BaseLayout from '../layouts/BaseLayout.astro';
const areas = [
  { id: 'applications', icon: '⌂', title: 'University and college applications', description: 'Find guidance on admission requirements, application documents, application periods and different pathways into higher education.', button: 'Explore application resources', points: ['Check entry requirements with each institution and qualification.', 'Prepare identity, academic and other documents requested by the institution.', 'Confirm application dates and submit through the official institution channel.'] },
  { id: 'funding', icon: '✦', title: 'Scholarships and bursaries', description: 'Discover verified scholarships, bursaries and education funding opportunities as listings become available.', button: 'Explore funding opportunities', points: ['Check the provider, eligibility criteria and required documents.', 'Confirm the closing date with the official provider.', 'Apply using the official provider’s link or instructions.'] },
  { id: 'skills', icon: '↗', title: 'Skills development and training', description: 'Find information about training programmes, digital skills, career development and other learning opportunities.', button: 'Explore skills opportunities', points: ['Consider the skills you want to build and the time you can commit.', 'Check the training provider and any entry requirements.', 'Confirm costs, dates and credentials before applying.'] },
  { id: 'rights', icon: '◎', title: 'Human rights learning resources', description: 'Access educational information and resources that promote understanding of human rights, equality, dignity and the right to education.', button: 'Explore learning resources', points: ['Learn about dignity, equality, inclusion and the right to education.', 'Discuss how these rights relate to everyday learning and community life.', 'Use reliable educational and official sources when exploring a topic.'] },
] as const;
---
<BaseLayout title="Education opportunities" description="Find guidance on higher education applications, bursaries, skills training and human rights learning with Back 2 School Africa Programme.">
  <section class="page-hero"><div class="wrap narrow"><span class="eyebrow">Education opportunities</span><h1>Find your next opportunity.</h1><p class="lead">Your next step in education or career development starts with the right information. Explore educational opportunities, discover funding resources and find guidance to help you plan your future.</p></div></section>
  <section class="section"><div class="wrap"><div class="opportunity-grid">{areas.map((area, index) => <article class="opportunity-card"><img class="opportunity-photo" src={['/images/study-guidance-v2.webp', '/images/reading-together-v2.webp', '/images/learning-hero-v2.webp', '/images/community-mentorship-v2.webp'][index]} alt="" loading="lazy" /><span class="card-icon" aria-hidden="true">{area.icon}</span><h2>{area.title}</h2><p>{area.description}</p><a class="text-link" href={`#${area.id}`}>{area.button} <span aria-hidden="true">→</span></a></article>)}</div></div></section>
  <section class="section wash"><div class="wrap"><span class="eyebrow">Plan your next step</span><h2 class="section-title">Start with reliable information.</h2><div class="opportunity-details">{areas.map(area => <article id={area.id}><div><span class="eyebrow">Guidance</span><h3>{area.title}</h3><p>{area.description}</p></div><div><ul class="check-list">{area.points.map(point => <li>{point}</li>)}</ul>{area.id === 'funding' && <p class="small">No scholarship or bursary listings have been published yet. Listings will appear only after the provider, eligibility, closing date and official application link have been checked.</p>}</div></article>)}</div></div></section>
  <section class="section"><div class="wrap opportunity-notice"><span class="eyebrow">Important information</span><h2>Confirm details with the provider.</h2><p>Back 2 School Africa Programme shares information and provides guidance but does not guarantee admission, scholarships, bursaries, employment or selection into any programme. Applicants should confirm details and submit applications through the relevant official provider.</p></div></section>
</BaseLayout>
