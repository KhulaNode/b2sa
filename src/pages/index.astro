---
import BaseLayout from '../layouts/BaseLayout.astro';
import { programmes } from '../data/programmes';
import '../styles/mockup-home.css';
---
<BaseLayout title="Home" description="Back2SchoolAfrica Programme is a nonprofit organisation committed to expanding educational access and empowering learners and young people.">
  <div class="mock-home">
    <section class="mock-hero">
      <div class="wrap mock-hero-grid">
        <div class="mock-hero-copy">
          <div class="mock-eyebrow">Education · Skills · Opportunity</div>
          <h1>Welcome to <em>Back2School<wbr />Africa </em>Programme</h1>
          <p>Back2SchoolAfrica Programme is a nonprofit organisation committed to expanding educational access and empowering learners and young people through learning, guidance, skills development, human rights education and community partnerships.</p>
        </div>
        <div class="mock-hero-art">
          <div class="mock-float mock-float-one"><span class="mock-spark" aria-hidden="true">✦</span><strong>Learn</strong><span>Build knowledge and skills</span></div>
          <div class="mock-art-frame"><img src="/images/learning-hero-v2.webp" width="1536" height="1024" alt="Illustrative image of learners studying together in a library" /><div class="mock-caption">Learning opens doors</div></div>
          <div class="mock-float mock-float-two"><span class="mock-spark" aria-hidden="true">✦</span><strong>Grow</strong><span>Explore what comes next</span></div>
        </div>
      </div>
    </section>

    <div class="mock-band mock-intro-band"><div class="wrap mock-band-grid mock-intro-grid">
      <div class="mock-band-item mock-intro-item"><span class="mock-band-icon" aria-hidden="true">↗</span><p>As the nonprofit arm of Tutor Mentor Connect, we focus on initiatives that help individuals access educational opportunities, build their capabilities and participate meaningfully in their communities.</p></div>
      <div class="mock-band-item mock-intro-item"><span class="mock-band-icon" aria-hidden="true">✳</span><p>We believe that every young person deserves the information, support and opportunities needed to pursue their aspirations.</p></div>
    </div></div>

    <section class="mock-story" id="purpose"><div class="wrap mock-story-grid">
      <div><div class="mock-eyebrow">Education opens doors</div><h2>Our Purpose</h2></div>
      <div class="mock-story-box"><p>We work to make educational opportunities more accessible by connecting learners and young people with learning initiatives, higher education guidance, scholarship information, skills development and human rights education.</p></div>
    </div></section>

    <section class="mock-section" id="programmes"><div class="wrap">
      <div class="mock-section-head"><div class="mock-eyebrow">Education · Skills · Opportunity</div><h2>What We Do</h2></div>
      <div class="mock-program-grid">{programmes.map((item, index) => <article class="mock-program"><img class="mock-program-photo" src={['/images/reading-together-v2.webp', '/images/study-guidance-v2.webp', '/images/study-guidance-v2.webp', '/images/learning-hero-v2.webp', '/images/reading-together-v2.webp', '/images/community-mentorship-v2.webp'][index]} alt="" loading="lazy" /><div class="mock-program-body"><div class="mock-icon" aria-hidden="true">{item.icon}</div><h3>{item.title}</h3><p>{item.intro}</p></div></article>)}</div>
    </div></section>

    <section class="mock-cta"><div class="wrap"><div class="mock-cta-inner">
      <div><h2>Be Part of the Change</h2><p>Educational progress is a shared responsibility. We welcome learners, volunteers, educators, institutions, organisations and sponsors who share our commitment to expanding opportunity.</p><p>Join us in building a future where more young people can learn, grow and thrive.</p></div>
      <div class="mock-cta-actions"><a class="mock-button" href="#programmes">Explore Our Programmes</a><a class="mock-button mock-gold" href="/get-involved/#partners">Partner With Us</a><a class="mock-button mock-secondary" href="/get-involved/#volunteers">Volunteer With Us</a></div>
    </div></div></section>
  </div>
</BaseLayout>
