---
import BaseLayout from '../layouts/BaseLayout.astro';
import { programmes } from '../data/programmes';
---
<BaseLayout title="Education that opens doors" description="Back2School Africa is an education-focused NPO supporting learning, skills and opportunity through community-rooted programmes.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow"><span class="eyebrow-dot"></span> Education · Skills · Opportunity</span>
        <h1>Every learner deserves a <em>way forward.</em></h1>
        <p class="lead">Education can open a door. We help people take the next step through practical learning support, guidance and connection.</p>
        <div class="actions"><a class="button" href="/programmes/">Explore our programmes <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">Get to know us <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="hero-visual">
        <div class="photo-frame"><img src="/images/joburg-library-learning.webp" width="634" height="615" alt="Children in a Johannesburg library using a tablet together for learning and reading" fetchpriority="high" /></div>
        <div class="photo-stamp"><span class="stamp-icon" aria-hidden="true">✳</span><span>Learning grows<br /><strong>together.</strong></span></div>
        <span class="photo-credit">Photo: <a href="https://commons.wikimedia.org/wiki/File:CHILDREN_USING_TABLETS_TO_PLAY_GAMES_AND_AND_READ_STORIES_AT_RABBI_RIDGE_LIBRARYJOBURG_SOUTH_AFRICA.jpg">JeffNyoka / Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Cropped and converted to WebP.</span>
      </div>
    </div>
  </section>
  <div class="promise-strip"><div class="wrap promise-grid"><span>For learners & families</span><span>From school to opportunity</span><span>Rooted in community</span></div></div>
  <section class="section" id="programmes"><div class="wrap">
    <div class="section-top"><div><span class="eyebrow">What we do</span><h2>Support for every stage<br />of the journey.</h2></div><p>Six connected areas make room for different goals, ages and pathways. Explore what each one offers.</p></div>
    <div class="programme-grid">{programmes.map((item, index) => <article class="programme-card"><span class="card-number">0{index + 1}</span><span class="card-icon" aria-hidden="true">{item.icon}</span><h3>{item.title}</h3><p>{item.intro}</p><a href={`/programmes/${item.slug}/`} aria-label={`Explore ${item.title}`}>Explore programme <span aria-hidden="true">↗</span></a></article>)}</div>
  </div></section>
  <section class="tmc-feature"><div class="wrap tmc-grid"><div><span class="eyebrow light">Introducing Tutor Mentor Connect</span><h2>Learning can go<br /><em>further together.</em></h2><p>One online learning ecosystem envisioned to connect primary, high-school and tertiary learners with tutors, study resources and professional mentors.</p><a class="button gold" href="/tutor-mentor-connect/">Explore Tutor Mentor Connect <span aria-hidden="true">↗</span></a></div><div class="tmc-diagram" aria-label="Tutor Mentor Connect brings learners, tutors and mentors together"><div class="orbit orbit-one">Learners</div><div class="orbit orbit-two">Tutors</div><div class="orbit orbit-three">Mentors</div><div class="orbit-core">Learn<br /><span>Connect</span><br />Grow</div></div></div></section>
  <section class="section story-section"><div class="wrap story-grid"><div><span class="eyebrow">Our purpose</span><h2>Restoring dignity through education.</h2><p class="lead">Back2School Africa is an education-focused NPO. Our work connects learning with skills development and stronger communities.</p><a class="text-link" href="/about/">More about our approach <span aria-hidden="true">→</span></a></div><div class="story-panel"><span class="story-mark" aria-hidden="true">“</span><h3>A path forward starts with a place to learn.</h3><p>From reading and tutoring to career choices and applications, each step deserves clear support and a welcoming community.</p></div></div></section>
  <section class="section next-step"><div class="wrap next-grid"><div><span class="eyebrow">Find your place</span><h2>There’s more than one way to take part.</h2></div><div class="next-links"><a href="/get-involved/#learners">Learners & parents <span aria-hidden="true">↗</span></a><a href="/get-involved/#tutors-mentors">Tutors & mentors <span aria-hidden="true">↗</span></a><a href="/get-involved/#partners">Volunteers, partners & donors <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
