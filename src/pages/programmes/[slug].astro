---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { programmes } from '../../data/programmes';
export function getStaticPaths() { return programmes.map(programme => ({ params: { slug: programme.slug }, props: { programme } })); }
const { programme } = Astro.props;
---
<BaseLayout title={programme.title} description={programme.intro}>
  <section class="page-hero"><div class="wrap narrow"><a class="back-link" href="/programmes/">← All programmes</a><span class="eyebrow">Back2School Africa programme</span><h1>{programme.title}</h1><p class="lead">{programme.intro}</p></div></section>
  <section class="section"><div class="wrap two-col"><div><span class="eyebrow">The focus</span><h2>Support with purpose.</h2></div><div class="prose"><p>{programme.description}</p><ul class="check-list">{programme.focus.map(item => <li>{item}</li>)}</ul>{programme.slug === 'tutoring' || programme.slug === 'mentoring' ? <a class="text-link" href="/tutor-mentor-connect/">See Tutor Mentor Connect <span aria-hidden="true">→</span></a> : null}</div></div></section>
  <section class="section wash"><div class="wrap editorial-callout"><h2>Interested in this programme?</h2><p>Find the right path as a learner, parent or supporter, or see how to reach the team.</p><div class="actions"><a class="button" href="/get-involved/">Find your path <span aria-hidden="true">↗</span></a><a class="text-link" href="/contact/">Contact <span aria-hidden="true">→</span></a></div></div></section>
</BaseLayout>
